  "input_contract": {
    "assembly": "hg38 GTF, source chromosome prefixes and strand retained",
    "experimental_unit": "CD34 bone marrow from one healthy donor; rep1/rep2 file labels not independent donors; metacells are computational aggregates",
    "required_keys": [
      "original RNA/ATAC barcode with sample prefix",
      "paired cell identity",
      "celltype",
      "Metacell assignment",
      "peak chr:start-end",
      "gene original ID/symbol",
      "strand",
      "palantir_pseudotime",
      "gene_res/sc_gene_res peak key"
    ],
    "original_genes": [
      "TAL1",
      "MPO",
      "IRF8",
      "GATA2",
      "FLI1",
      "ELF1",
      "GATA1",
      "KLF1"
    ],
    "preprocessing": "raw retained; RNA2.5/99.5 count percentiles,FRIP>.4,mitochondrial<25%; min_cells50 then100; normalize_per_cell; log2(x+.1)-log2(.1); HVG2500 then1500; PCA50",
    "normalization": "sum raw counts separately by same ATAC metacell; per-metacell totals normalized; coverage per-million group total fragments with75bp rolling mean",
    "association_model": "Pearson +/-100kb,100 GC/accessibility matched background peaks, nominal p<.1; displayed marker scatter reports Spearman",
    "display_thresholds": "NFR panel p<.1 and cor>.2; All panel p<.1 and cor>.02 with different peak/correlation source",
    "seed": "Fig3CD model np.random.seed(11); other pipeline seeds not completely locked",
    "source_discrepancies": [
      "NFR coverage <=145bp versus manuscript peak-calling<147bp differ at length146 and are different stages",
      "LassoCV(cv=5) source versus manuscript10fold",
      "Printed TAL10.8274 versus final0.82",
      "Fig1 grouping digitize maximum edge risk demonstrated on synthetic ranks; no demonstrated paper result change"
    ],
    "missing_data": [
      "h5ad raw/count layers",
      "fragment files",
      "metacell labels",
      "DORC pickle correlation tables",
      "TF-target FIMO matrix",
      "exact covariance genes"
    ]
  },
