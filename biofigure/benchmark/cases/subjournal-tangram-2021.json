  "input_contract": {
    "required_fields": [
      "same tissue/anatomical-region sc/snRNA and spatial expression",
      "overlapping original gene IDs",
      "training/test gene flags",
      "cell IDs and cell-subclass annotations",
      "spot/cell coordinate IDs and xy unit/orientation",
      "cell×spot mapping matrix plus declared normalization",
      "for deconvolution:spot segmentation centroids,cell count per spot,constrained mapping",
      "display normalization per gene/type with clipping declared"
    ],
    "experimental_units": "reference cells/voxels are observational units; separate tissue sections/samples must remain separate; inferred cells are not independent biological replicates.",
    "preprocessing": [
      "paper-era pp_adatas lowercases gene names,makes unique,drops allzero genes,locks gene intersection,computes uniform andRNA-count density prior",
      "paper MERFISH253 shared training genes;4234 segmented cells; paper Visium1237 marker genes fromtop100 per type and939 segmented cells inROI (original not rerun)",
      "mapping softmax across spatial dimension; stochastic initialization; random_state defaultNone; seed0 caveat",
      "project annotations via mapping transpose × onehot; project_genes via mapping transpose × expression",
      "plot helper orders values ascending so strong points draw last;equal aspect andinverted y",
      "helper robust quantile normalization can change scale semantics and must be rebound for reuse"
    ],
    "units": "probability or relative projected annotation intensity must be distinguished from0–1 normalized expression; fluorescence andmRNA counts have different raw units",
    "missing_values": "do not align cells/genes by position alone; absent genes are not measuredzeros; zero-density/constant map range must be checked",
    "seed": "paper final panel seeds not located; do not infer from tutorial defaults; spot-internal assignment is arbitrary/random with respect to segmented identity"
  },
