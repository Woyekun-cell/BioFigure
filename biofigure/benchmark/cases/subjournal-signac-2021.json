  "input_contract": {
    "assembly": "hg38 / EnsDb.Hsapiens.v86 / BSgenome.Hsapiens.UCSC.hg38 for Fig2",
    "experimental_unit": "PBMC multiome same-cell paired ATAC+RNA; cells or cell types do not establish independent donor n",
    "required_keys": [
      "cell barcode",
      "sample/donor",
      "RNA/ATAC same-cell pairing",
      "celltype",
      "peak genomic ranges",
      "gene coordinates/strand",
      "motif IDs",
      "link score/zscore/pvalue"
    ],
    "original_display_genes": [
      "MS4A1",
      "LYZ",
      "EOMES",
      "TBX21",
      "TBX2"
    ],
    "preprocessing": "seed1234 in process_pbmc; QC ATAC5000<count<70000,RNA1000<count<25000,nucleosome<2,TSS>1; MACS2 max-gap50; min.cells5; TF-IDF/SVD LSI2:40",
    "normalization": "coverage=count/group_total_depth*median_group_total_depth then centered100bp rolling sum; RNA SCT for LinkPeaks",
    "link_defaults": "Signac1.2.0 Pearson,distance500kb,min.cells10,n_sample200,abs.score>.05,nominal p<.05 using pnorm(-abs(z))",
    "replication": "LinkPeaks script separate process lacks local set.seed; upstream process seed does not guarantee random background draws",
    "missing_data": [
      "PBMC fragment files",
      "feature matrices and paired barcodes",
      "pbmc.rds",
      "pbmc_links.rds",
      "actual20x20 confusion table"
    ]
  },
