  "input_contract": {
    "assembly": "hg19 for selected human figures; mm9 only for unrelated mouse atlas",
    "experimental_unit": "49-sample cross-platform hematopoietic compendium; cells, pseudobulk and trajectory bins are not independent donors",
    "required_keys": [
      "Sample",
      "cellNames",
      "ClustFinal",
      "peakATAC chr:start-end",
      "geneRNA chr:TSS#symbol",
      "motif original IDs",
      "paired peak-gene row key",
      "pseudotime"
    ],
    "trajectory_order": [
      "C1_HSC",
      "C2_CMP.LMPP",
      "C7_CLP.1",
      "C8_CLP.2",
      "C9_PreB",
      "C10_B"
    ],
    "preprocessing": "ArchR0.2.1; seed1; filterTSS4, fragments1000-50000; 25000 variable features/landmarks; upstream filtered RDS absent",
    "transformations": "getTrajectory smoothWindow11; Motif log2NormFALSE; GS/RNA/ATAC TRUE; per-row or per-column Z score must retain panel semantics",
    "thresholds": "marker FDR<=.01 and Log2FC>=1; motif correlation>.5/padj<.001 plus top-half maxDelta; trajectory pre/post filter quantile.8/.9",
    "coordinate_convention": "Source interval strings preserved; table end-start=500; do not silently convert BED/IRanges endpoints",
    "available_small_data": "Official original SupplementaryTable5 in raw xlsx;38 HMGA1/BLK extracted rows",
    "missing_data": [
      "filtered ArchR project/Arrow files",
      "RNA reference",
      "11,999 trajectory matrix and full ordering",
      "final browser track generation settings"
    ]
  },
