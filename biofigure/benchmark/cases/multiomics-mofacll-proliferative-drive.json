      5000,
      217
    ],
    "rna_observed_patients": 202,
    "rna_whole_modality_missing_patients": 15,
    "network_semantics": "gene to pathway membership, not interaction/correlation/causality",
    "unit": "patients; gene identifiers preserved; model F4 is continuous",
    "required_heatmap_columns": [
      "id",
      "symbol",
      "coef",
      "adj.P.Val"
    ],
    "statistics": "reuse author estimates; no model training or new biological inference"
  },
  "packages_by_role": {
    "DESeq2": "source VST and LF4 regression (not rerun)",
    "MOFA": "stored factors/train matrices (model not retrained)",
    "dplyr/tidyr": "ID joins, significance/coef filters, orders",
    "ComplexHeatmap": "heatmaps and matching annotations",
    "circlize": "CLL-PD annotation colour map",
    "igraph/tidygraph/ggraph": "bipartite network and seed2 nicely numerical layout",
    "cowplot": "grid assembly and detached legends",
    "readxl": "formal publisher source data"
  },
  "processing": {
    "heatmap_selection": "adj.P.Val < .01 and coef > 0 intersect Hallmark v6.2",
    "rows": "descending LF4 regression coef, gene id index, symbol label",
    "columns": "ascending first annotation column CLL-PD, identity-keyed same patient order",
    "clustering": "rows FALSE, columns FALSE; no distance/linkage",
    "scaling": "row z-score then clip +-4, keep raw values/stats",
    "color_scale": "100 colour vector actual range; not guaranteed white=0; CLL-PD separate white-green min/max",
    "network": "union gene names + pathway names, zero-based ids, retain cross-set membership edges, seed2 nicely"
  },
  "visual_observations": {
    "source_viewed": true,
    "network": "three hubs triangular with exclusive spokes and shared-gene bridges; pathway-only labels",
    "heatmap": "three aligned tall blocks, top gradient, italic labels with red mito subset, common right legends",
    "assembly_gap": "part5 gives Fig4 cowplot drafts, full ED6 page assembled separately/not found in this source"
  },
