  "input_contract": {
    "genomes": 6,
    "genes": 143,
    "TIRs": 12,
    "NGARO_insertions": 3,
    "GC_windows": 2856,
    "nucleotide_links": 125,
    "protein_links": 827,
    "coordinate_unit": "bp for genome features, amino-acid positions for protein sublinks",
    "keys": "seq_id and feat_id retained verbatim; author order retained",
    "statistics": "descriptive only; no replicate or inferential statistics"
  },
  "packages_by_role": {
    "gggenomes": "sequence layout, feature strand geometry, add_sublinks aa2nuc transforms, adjacent protein ribbons, direction sync, GC wiggle",
    "ggplot2": "semantic scales and themed guides",
    "ragg": "authorized raster QA",
    "grDevices": "native vector PDF"
  },
  "r_functions": [
    "gggenomes",
    "geom_feat",
    "geom_seq",
    "geom_link",
    "geom_gene",
    "geom_gene_tag",
    "geom_feat_note",
    "geom_wiggle",
    "add_sublinks",
    "sync",
    "flip",
    "focus"
  ],
  "visual_observations": {
    "panels": "six aligned genome rows, right gene and GC legends, bottom genomic axis",
    "layers": "TIR blocks, black sequence baselines, pale protein ribbons, six named gene classes with unknown genes in cornsilk3, 45-degree gene tags, three NGARO shaded insertion intervals, per-row GC wiggle",
    "density": "143 genes across six tracks, 12 terminal repeats, three interval insertions, dense adjacent-row links; source width:height=2:1"
  },
  "processing": {
    "main": "gggenomes(genes,seqs,links=emale_ava,feats=list(TIR,ngaros,GC)); add_sublinks(protein); sync(default first nucleotide link track); draw links(2) protein alignments",
    "orientation": "sync is a heuristic using adjacent-link nucleotide-width support; protein positions map to genomic coordinates via aa2nuc and source gene strand",
    "GC": "relative wiggle uses pooled median and 2.5/97.5 percentiles; not a calibrated GC axis",
    "version_drift": "Upstream1.2.0 fixed commit installed in task-only R library; shared1.1.3 not used. Shared1.1.3 nucleotide alignment starts differ by1bp; never mix silently."
  },
  "gaps": [
    {
      "detail": "Runtime1.2.0 is installed from locked source in isolated task library; shared1.1.3 is not used."
    },
    {
      "detail": "Original PNG pixel identity not promised due final physical-size typography adaptation."
    },
    {
      "detail": "Same-data strand transformations are bounded stress tests, not independent new biological data."
    }
  ],
