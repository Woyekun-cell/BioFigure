  "input_contract": {
    "required_columns": [
      "seqnames",
      "start",
      "end",
      "strand",
      "type",
      "gene_name",
      "transcript_name",
      "transcript_biotype"
    ],
    "assembly": "GRCh38/hg38",
    "annotation_release": "Ensembl105",
    "SOD1": {
      "transcripts": 4,
      "exons": 20,
      "introns": 16
    },
    "PKNOX1": {
      "transcripts": 11,
      "exons": 59,
      "introns": 48
    },
    "coordinate_contract": "Input annotation is one-based closed. to_intron plotting ranges include adjacent exon boundaries. shorten_gaps output is synthetic visualization coordinate only, preserving exon lengths and cross-transcript alignment. No interpretation as genomic distance.",
    "replicates": "none; reference annotation structures",
    "statistics": "descriptive interval comparison; no expression or inference",
    "sampling": false
  },
  "packages_by_role": {
    "ggtranscript": "native geom_range, geom_intron, geom_half_range, to_intron, shorten_gaps, to_diff",
    "GenomicRanges": "native set differences, interval gap detection",
    "GenomeInfoDb": "native seqlevel pruning",
    "ggplot2": "scales, coordinate labels, compact vector assembly",
    "ragg": "authorized PNG"
  },
  "r_functions": [
    "geom_range",
    "geom_intron",
    "geom_half_range",
    "to_intron",
    "shorten_gaps",
    "to_diff"
  ],
  "visual_observations": {
    "SOD1": "four ordered full gene transcript rows; exon rectangle colors encode biotype; intron arrows encode positive strand",
    "PKNOX1": "eleven aligned rows, long introns shortened to100bp gaps, exon differences compared against201,201/203 half ranges share centerline"
  },
