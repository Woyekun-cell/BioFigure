  "input_contract": {
    "required_fields": [
      "ligand symbol",
      "target symbol",
      "tumor_id",
      "CAF/malignant annotation",
      "original expression transform",
      "prior ligand-target regulatory potential",
      "Pearson ranking statistic",
      "pEMT gene set and background expressed genes",
      "per-tumor pEMT mean"
    ],
    "experimental_units": "10 tumors in Fig2c/d; cells aggregated within tumor. Ligand rows are predictions, not biological replicates.",
    "preprocessing": [
      "source tumor exclusions explicit; primary tumor cells only Lymph node=0",
      "expressed gene cutoff log2(mean(10*(2**x-1))+1)≥4; CAF ligands plus expressed malignant receptors",
      "top20 ligands by Pearson to pEMT set vs expressed background",
      "top250 targets per ligand intersect pEMT; below pooled25%weight cutoff set0",
      "target order:dist(1-cor(t(matrix)))→Ward.D2; ligand ranking locked shared a/b",
      "tumor order:ascending mean pEMT; actual top→bottom reverses factor levels",
      "panelc:mean malignant expression per tumor then dynutils::scale_quantile; source Excel keeps pre-scaling values"
    ],
    "units": "regulatory potential andPearson dimensionless; aggregated expression transform source-specific; display0–1 quantile scale; pEMT score separate",
    "missing_values": "visualized0 is thresholded low prior potential; absent source values must not silently impute0",
    "seed": "deterministic panel heatmaps after fixed matrices; source broader RF/CV stochastic analyses not executed; no seed invented"
  },
