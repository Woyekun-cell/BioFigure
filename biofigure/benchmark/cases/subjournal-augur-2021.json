  "input_contract": {
    "unit": "cells are classifier CV rows; animal/sample identifiers required separately for biological generalization",
    "fields": [
      "features×cells preprocessed matrix",
      "metadata label",
      "metadata cell_type",
      "optional independent sample/animal ID for a separately designed grouped validation",
      "AUC output cell_type,auc",
      "differential output auc.x,auc.y,pval,z"
    ],
    "preprocessing": "prepared cell annotations/features; default50 subsamples,20 cells per label,3-fold stratified cell CV;variance feature selection quantile0.5 then feature_perc0.5;RF100 trees,mtry2",
    "seed": "set.seed(subsample_idx) inside each subsample; RF engine seed1; cell CV does not group by animal; no classifier trained here"
  },
  "packages_by_role": {
    "scientific_computation": [
      "Augur",
      "parsnip",
      "rsample",
      "yardstick",
      "randomForest/ranger"
    ],
    "rendering": [
      "ggplot2",
      "ggrepel",
      "pals"
    ]
  },
