      "raw expression/var_names including Bpifb1,Krt5,Trp63"
    ],
    "preprocessing": "min_cells10 raw; normalize_per_cell+log1p; velocity filter min_shared_counts20,n_top_genes2000; KNN30; stochastic velocity connectivity weight0.2;9 macrostates,n_cells30; all macrostates treated terminal; GMRES absorption probabilities",
    "seed": "NumPy0,PYTHONHASHSEED0; explicit random.seed(0) repair; original bug archived",
    "raw_input_sha256": "773bd90b17b103e1168e46aa5dab0e00df59cb6903d600ceae0043d73035c3a4",
    "subset": "Goblet/Basal1239; own15-neighbor graph/kernel/GPCCA/Palantir; never use global fate column"
